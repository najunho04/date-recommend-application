<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutProfileEdit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.User.UserProfileEditActivity">

    <!-- ================= 상단 바 ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/bg_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 앱 로고 -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="app logo"
            android:src="@drawable/app_icon_64px" />

        <!-- 타이틀 -->
        <TextView
            android:layout_marginStart="12dp"
            android:text="프로필 수정"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <!-- 뒤로가기 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="back"
            android:src="@drawable/arrow_back_32px" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toTopOf="@+id/btnSaveProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 닉네임 -->
            <TextView
                android:id="@+id/tvLabelNickName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="닉네임"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditNick" />

            <FrameLayout
                android:id="@+id/frameNickName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvLabelNickName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditNick">

                <TextView
                    android:id="@+id/tvNickName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Na Junho"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editNickName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="닉네임 수정"
                    android:visibility="gone"
                    android:inputType="textPersonName" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnEditNick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="#F7C6B8"
                android:text="수정"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/frameNickName" />

            <!-- 나이 -->
            <TextView
                android:id="@+id/tvLabelAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="나이"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/frameNickName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditAge" />

            <FrameLayout
                android:id="@+id/frameAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvLabelAge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditAge">

                <TextView
                    android:id="@+id/tvAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="26"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="나이 수정"
                    android:visibility="gone"
                    android:inputType="number" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnEditAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_login_button"
                android:textColor="@color/black"
                android:text="수정"
                app:layout_constraintTop_toTopOf="@id/frameAge"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 지역 -->
            <TextView
                android:id="@+id/tvLabelLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="지역"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/frameAge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditLocation" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Seoul"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/tvLabelLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditLocation" />

            <TextView
                android:id="@+id/btnEditLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_login_button"
                android:text="수정"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvLocation" />

            <!-- 성별 -->
            <TextView
                android:id="@+id/tvLabelGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="성별"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditGender" />

            <TextView
                android:id="@+id/tvGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Male"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/tvLabelGender"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnEditGender" />

            <TextView
                android:id="@+id/btnEditGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_login_button"
                android:textColor="@color/black"
                android:text="수정"
                app:layout_constraintTop_toTopOf="@id/tvGender"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 흥미 -->
            <TextView
                android:id="@+id/tvLabelInterests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="흥미"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvGender"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/btnInterests"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="AI, Coding, Finance"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_login_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLabelInterests" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupInterests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacing="8dp"
                android:layout_margin="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnInterests"
                app:singleLine="false"
                app:singleSelection="false" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- 저장 버튼 (고정 위치) -->
    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:text="저장하기"
        android:textColor="@color/black"
        android:layout_margin="16dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_login_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
