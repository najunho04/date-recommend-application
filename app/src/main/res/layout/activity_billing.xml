<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= 상단 바 ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/bg_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 앱 로고 -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/app_icon_64px"
            android:contentDescription="app logo"/>

        <!-- 타이틀 -->
        <TextView
            android:layout_marginStart="12dp"
            android:text="포인트 구매"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <!-- 뒤로가기 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="back"
            android:src="@drawable/arrow_back_32px" />
    </LinearLayout>

    <!-- ================= 구매 버튼 영역 ================= -->
    <LinearLayout
        android:id="@+id/purchaseLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/buy_500_button"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="100p : 500원"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            android:background="@drawable/bg_button_pink"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/buy_2000_button"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="500p : 2000원"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_pink"
            android:backgroundTint="@null"/>

        <Button
            android:id="@+id/buy_5000_button"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="1500p : 5000원"
            android:textColor="@color/black"
            app:backgroundTint="@null"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_pink"
            android:backgroundTint="@null"/>
    </LinearLayout>

    <!-- ================= 구분선 ================= -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="40dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/purchaseLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- ================= 안내 텍스트 ================= -->
    <TextView
        android:id="@+id/tvNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="결제 로직이 준비중입니다..."
        android:textSize="14sp"
        android:textColor="#000000"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
