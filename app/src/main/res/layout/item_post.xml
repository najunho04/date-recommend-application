<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_post_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="4dp"
    tools:layout_width="200dp"
    tools:layout_height="300dp">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:layout_height="wrap_content">

    <!-- ⭐ 정사각형 비율 유지 -->
<androidx.constraintlayout.widget.ConstraintLayout
android:id="@+id/post_container"
android:layout_width="0dp"
android:layout_height="0dp"
app:layout_constraintDimensionRatio="2:3"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">


    <ImageView
        android:id="@+id/post_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/text_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_launcher_background" />

    <LinearLayout
    android:id="@+id/text_container"
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:padding="8dp"
    android:background="#FAFAFA"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toBottomOf="@id/post_image">

    <!-- 제목 -->
    <TextView
        android:id="@+id/post_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="포스트 제목"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- 날짜 -->
    <TextView
        android:id="@+id/post_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2024-01-01"
        android:textSize="12sp"
        android:textColor="#777777"
        android:paddingTop="2dp" />

    <!-- 🔹 좋아요 / 리트윗 / 댓글 텍스트 아이콘 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="28dp"
        android:layout_marginStart="4dp"
        android:paddingTop="6dp">

        <ImageButton
            android:id="@+id/post_likes_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:textSize="11sp"
            android:src = "@drawable/like_32px"
            android:textColor="#333333"
            android:backgroundTint="#F5F5F5"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/post_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/post_retweet_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src = "@drawable/retweet_32px"
            android:textSize="14sp"
            android:backgroundTint="#F5F5F5"
            android:textColor="#333333"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/post_retweet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/post_comments_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src = "@drawable/comment_32px"
            android:textSize="14sp"
            android:backgroundTint="#F5F5F5"
            android:textColor="#333333"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/post_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="13sp"
            android:textColor="#555555"/>
    </LinearLayout>

</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
