<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commentCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp"
    android:backgroundTint="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 🔹 상단: 프로필 + 작성자명 + 수정/삭제 메뉴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/commentAuthorImage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/app_icon_64px"
                android:scaleType="centerCrop"
                android:contentDescription="작성자 이미지"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/commentAuthorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="홍길동"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:paddingHorizontal="12dp"
                android:text="수정"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_rounded_white_button"
                android:textColor="#000000"
                android:layout_marginEnd="4dp"
                />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:paddingHorizontal="12dp"
                android:text="삭제"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_rounded_white_button"
                android:textColor="#000000"
                />
        </LinearLayout>

        <!-- 🔹 댓글 내용 -->
        <TextView
            android:id="@+id/commentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="정말 좋은 코스네요! 다음에 가봐야겠어요 😊"
            android:textColor="@color/black"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="6dp"
            android:visibility="visible" />

        <!-- 수정 중일 때 표시되는 EditText -->
        <EditText
            android:id="@+id/commentEditField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="댓글 수정 중..."
            android:inputType="textCapSentences"
            android:imeOptions="actionDone"
            android:visibility="gone" />

        <!-- 🔹 하단: 작성 시각 -->
        <TextView
            android:id="@+id/commentCreatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2시간 전"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
