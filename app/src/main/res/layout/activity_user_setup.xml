<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userSetupLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Activity.User.UserSetUpActivity">

    <!-- 🔹 상단 로고 + 제목 -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher_for_app_logo_round"
            android:contentDescription="App Logo"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DateRecommendationApp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- 🔹 유저 프로필 영역 -->
    <LinearLayout
        android:id="@+id/profileLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="User Profile Image"
            android:background="@drawable/profile_border"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임 예시"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#898686" />
    </LinearLayout>

    <!-- 🔹 기능 버튼 리스트 (스크롤 가능) -->
    <ScrollView
        android:id="@+id/scrollMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/profileLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="100dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle">

            <Button
                android:id="@+id/btnChangeNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="닉네임 변경"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnMyPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="내 게시물 보기"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnMyLikes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="내 좋아요 보기"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnMyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="내 정보 수정"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="로그아웃"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnWithdraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="탈퇴"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/navigationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnMainFeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="메인 화면"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"/>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btnUserInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="유저 정보"
            android:backgroundTint="#424242"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
