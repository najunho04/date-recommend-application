<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= 상단 바 ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:background="@drawable/bg_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/app_icon_64px"
            android:contentDescription="app logo"/>

        <TextView
            android:layout_marginStart="12dp"
            android:text="My Page"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ================= 스크롤 영역 ================= -->
    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 저장 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="저장"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnMyPosts"
                android:clickable="true"
                android:focusable="true"
                android:text="내 게시물 보기"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:id="@+id/btnMyLikes"
                android:clickable="true"
                android:focusable="true"
                android:text="좋아요 게시물 보기"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <!-- 정보 수정 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:text="정보 수정"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:id="@+id/btnMyInfo"
                android:clickable="true"
                android:focusable="true"
                android:text="내 프로필 수정"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:id="@+id/btnChangeNickname"
                android:clickable="true"
                android:focusable="true"
                android:text="닉네임 변경"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:id="@+id/btnLogout"
                android:clickable="true"
                android:focusable="true"
                android:text="로그아웃"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:id="@+id/btnWithdraw"
                android:clickable="true"
                android:focusable="true"
                android:text="회원 탈퇴"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <!-- 결제 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:text="결제"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:id="@+id/btn_buy_point"
                android:clickable="true"
                android:focusable="true"
                android:text="포인트 구매"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <!-- 문의 사항 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:text="문의 사항"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="버그 문의"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="결제 문의"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="광고 문의"
                style="@style/FlatButton"
                android:layout_marginStart="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ================= 하단 버튼 바 ================= -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnViewMap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/search_icon_32px"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지도 검색"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnMainFeed"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/home_icon_32px"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="메인화면"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnUserInfo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/user_icon_32px"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마이 페이지"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
